# No real secrets in source control. Generate separate random secret/key before deployment.
SERVERNET_STUDIO_ORIGIN=https://studio.servernet.cloud
SERVERNET_STUDIO_CLIENT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SERVERNET_STUDIO_ENCRYPTION_KEY=REPLACE_WITH_A_FERNET_KEY
# Must point to the corresponding published version, including legal notices.
SERVERNET_STUDIO_SOURCE_URL=https://github.com/servernetir/servernet-studio/tree/develop
# Mount the existing ServerNet licensed IRANSans directory; fonts are not copied into the public source distribution.
# Docker Compose uses this host directory as the /run/servernet/fonts volume.
SERVERNET_FONT_DIRECTORY=/absolute/path/to/servernet/website/public/assets/font/woff2
# For Passenger, configure SERVERNET_STUDIO_FONTS and SERVERNET_STUDIO_DB as
# private absolute paths, or use runtime/config.json; see CPANEL.md.
# Optional alternate private JSON path (an explicit missing file fails startup):
# SERVERNET_STUDIO_CONFIG=/absolute/private/path/config.json
